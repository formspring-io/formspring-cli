/**
 * Writes one named command per REST operation of the resource groups below,
 * straight from schema/openapi.json + schema/parity-map.json.
 *
 *   npm run scaffold-resources
 *
 * Generated files carry a "Generated by scaffold-resource-commands" marker and are
 * rewritten on every run. Files without the marker (hand-written commands) are never
 * touched. The list of generated commands is saved to schema/cli-commands.json so
 * `formspring commands` and `npm run check:parity` can report them.
 */
import { existsSync, mkdirSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { flagNameFor, type ResourceSpec } from '../src/lib/resource-command.ts'

const root = join(dirname(fileURLToPath(import.meta.url)), '..')
const MARKER = 'Generated by scaffold-resource-commands'

type OpenApiParameter = {
  name: string
  in: 'path' | 'query' | 'header'
  description?: string
  schema?: { type?: string }
}

type OpenApiOperation = {
  summary?: string
  parameters?: OpenApiParameter[]
  responses?: Record<string, { content?: Record<string, unknown> }>
}

type OpenApi = {
  paths: Record<string, Record<string, OpenApiOperation | OpenApiParameter[]>>
}

type ParityRow = {
  method: string | null
  path: string | null
  name: string | null
  transport: string
}

/** Route-name prefixes (after "api.") that get named commands. Everything else stays on `api request`. */
const RESOURCE_PREFIXES = [
  'contacts',
  'contact-fields',
  'contact-lists',
  'contact-tags',
  'contact-views',
  'contact-access-exports',
  'companies',
  'deals',
  'tasks',
  'pipelines',
  'lifecycle-stages',
  'crm',
  'links',
  'forms.attribution',
  'funnels.attribution',
  'funnels.analytics',
  'forms.automations',
  'funnels.automations',
  'surveys.automations',
  'automation-limits',
  'feedback-hub',
  'data-tables',
  'forms.document-templates',
  'forms.submissions.documents',
  'forms.submissions.signing',
  'forms.submissions.files',
  'forms.imports',
  'forms.webhooks',
  'bookings',
  'migrations',
  'sandbox',
  'tokens.audit',
]

/** Command names that differ from the name derived from the route (kept stable for existing docs). */
const PINNED_NAMES: Record<string, string> = {
  'forms.imports.show': 'forms imports show',
  'migrations.show': 'migrations status',
  'migrations.dry-run': 'migrations plan',
  'migrations.store': 'migrations start',
  'sandbox.workspaces.index': 'sandbox list',
  'sandbox.workspaces.store': 'sandbox create',
  'sandbox.workspaces.destroy': 'sandbox delete',
  'forms.webhooks.previous-secret.destroy': 'forms webhooks end-rotation',
  'forms.webhooks.deliveries.inspect': 'forms webhooks inspect',
  'forms.submissions.files.download': 'forms submissions download-file',
}

/** Routes whose file response is not described in the OpenAPI document. */
const DOWNLOAD_OVERRIDES: Record<string, string> = {
  'forms.submissions.files.download': 'application/octet-stream',
}

/** Existing generated commands that this script replaces (they gain --output streaming). */
const REPLACES_LEGACY = new Set(['forms submissions download-file'])

const VERBS: Record<string, string> = {
  index: 'list',
  show: 'get',
  store: 'create',
  destroy: 'delete',
}

function matchesPrefix(routeName: string): boolean {
  return RESOURCE_PREFIXES.some((prefix) => routeName === prefix || routeName.startsWith(`${prefix}.`))
}

function commandFor(routeName: string): string {
  if (PINNED_NAMES[routeName]) {
    return PINNED_NAMES[routeName]
  }

  const parts = routeName.split('.')
  parts[parts.length - 1] = VERBS[parts[parts.length - 1]] ?? parts[parts.length - 1]

  return parts.join(' ')
}

function pascal(command: string): string {
  return command
    .split(/[\s-]+/)
    .map((part) => part.replace(/[^a-z0-9]/gi, '').replace(/^./, (c) => c.toUpperCase()))
    .join('')
}

function oneLine(text: string): string {
  const flat = text.replace(/\s+/g, ' ').trim()

  return flat.length > 400 ? `${flat.slice(0, 397)}...` : flat
}

function pathParamNames(path: string): string[] {
  return [...path.matchAll(/\{([^}]+)\}/g)].map((match) => match[1])
}

const openapi = JSON.parse(readFileSync(join(root, 'schema/openapi.json'), 'utf8')) as OpenApi
const parity = JSON.parse(readFileSync(join(root, 'schema/parity-map.json'), 'utf8')) as ParityRow[]

const seenCommands = new Map<string, string>()
const seenRoutes = new Set<string>()
const manifest: Array<{ cli_command: string; method: string; path: string; name: string }> = []
const generated = new Set<string>()
const skippedNoSpec: string[] = []
let kept = 0

for (const row of parity) {
  if (row.transport !== 'rest' || !row.name || !row.method || !row.path) {
    continue
  }

  const routeName = row.name.replace(/^api\./, '')

  if (!matchesPrefix(routeName) || seenRoutes.has(row.name)) {
    continue
  }

  const pathItem = openapi.paths[row.path]
  const operation = pathItem?.[row.method.toLowerCase()] as OpenApiOperation | undefined

  if (!operation) {
    skippedNoSpec.push(`${row.method} ${row.path}`)
    continue
  }

  seenRoutes.add(row.name)

  const command = commandFor(routeName)
  const previous = seenCommands.get(command)

  if (previous) {
    throw new Error(`Command "${command}" would be generated for both ${previous} and ${row.name}`)
  }

  seenCommands.set(command, row.name)

  const pathLevel = (pathItem.parameters as OpenApiParameter[] | undefined) ?? []
  const operationLevel = operation.parameters ?? []
  const method = row.method.toUpperCase()

  const pathParams = pathParamNames(row.path).map((name) => ({ name, flag: flagNameFor(name, 'path') }))
  const queryParams = [...pathLevel, ...operationLevel]
    .filter((param) => param.in === 'query')
    .filter((param, index, all) => all.findIndex((other) => other.name === param.name) === index)
  const idempotent = operationLevel.some((param) => param.in === 'header' && param.name === 'Idempotency-Key')

  const query = queryParams.map((param) => ({
    name: param.name,
    flag: flagNameFor(param.name, 'query'),
    type: (param.schema?.type === 'integer' ? 'integer' : 'string') as 'string' | 'integer',
    ...(param.description ? { description: oneLine(param.description) } : {}),
  }))

  const flagNames = [...pathParams.map((p) => p.flag), ...query.map((q) => q.flag)]

  if (new Set(flagNames).size !== flagNames.length) {
    throw new Error(`Duplicate flag names for ${command}: ${flagNames.join(', ')}`)
  }

  const downloadType =
    DOWNLOAD_OVERRIDES[routeName] ??
    Object.keys(operation.responses?.['200']?.content ?? {}).find((type) => !type.includes('json'))

  const spec: ResourceSpec = {
    route: row.name,
    method,
    path: row.path,
    pathParams,
    query,
    hasBody: ['POST', 'PUT', 'PATCH'].includes(method),
    idempotent,
    paginated: method === 'GET' && queryParams.some((param) => param.name === 'cursor'),
    ...(downloadType ? { download: { contentType: downloadType } } : {}),
  }

  const parts = command.split(' ')
  const leaf = parts.pop() as string
  const file = join(root, 'src/commands', ...parts, `${leaf}.ts`)

  if (existsSync(file)) {
    const existing = readFileSync(file, 'utf8')

    if (!existing.includes(MARKER) && !(REPLACES_LEGACY.has(command) && existing.includes('Generated from'))) {
      kept += 1
      continue
    }
  }

  const depth = '../'.repeat(parts.length + 1)
  const requiredFlags = pathParams.map((param) => `--${param.flag} VALUE`).join(' ')
  const example = `<%= config.bin %> ${command} ${requiredFlags}${requiredFlags ? ' ' : ''}--json`
  const description = oneLine(operation.summary ?? `${method} ${row.path}`)

  const content = `/* ${MARKER} from ${row.name}. Do not edit by hand: run npm run scaffold-resources. */
import { ResourceCommand, resourceFlags, type ResourceSpec } from '${depth}lib/resource-command.js'

const spec: ResourceSpec = ${JSON.stringify(spec, null, 2)}

export default class ${pascal(command)}Resource extends ResourceCommand {
  static description = ${JSON.stringify(description)}

  static examples = [${JSON.stringify(example.trim())}]

  static spec = spec

  static flags = resourceFlags(spec)
}
`

  mkdirSync(dirname(file), { recursive: true })
  writeFileSync(file, content)
  generated.add(file)
  manifest.push({ cli_command: command, method, path: row.path, name: row.name })
}

// Remove generated files whose operation no longer exists in the API.
function prune(dir: string): void {
  for (const entry of readdirSync(dir)) {
    const full = join(dir, entry)

    if (statSync(full).isDirectory()) {
      prune(full)

      if (readdirSync(full).length === 0) {
        rmSync(full, { recursive: true })
      }

      continue
    }

    if (entry.endsWith('.ts') && !generated.has(full) && readFileSync(full, 'utf8').includes(MARKER)) {
      rmSync(full)
      console.log(`Removed ${full.replace(`${root}/`, '')} (operation no longer in the API)`)
    }
  }
}

prune(join(root, 'src/commands'))

writeFileSync(join(root, 'schema/cli-commands.json'), `${JSON.stringify(manifest, null, 2)}\n`)

console.log(`Generated ${generated.size} resource commands (${kept} hand-written commands kept)`)

if (skippedNoSpec.length > 0) {
  console.log(`Skipped ${skippedNoSpec.length} routes missing from openapi.json: ${skippedNoSpec.join(', ')}`)
}
